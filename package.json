{
    "name": "indoscraping",
    "version": "0.1.0",
    "description": "Indonesian web scrapers collection",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "scrape:detik": "uv run python src/indoscraping/scraper/news/detik.py",
        "scrape:alfagift": "node src/indoscraping/scraper/retail/alfagift/index.mjs",
        "scrape:indomaret": "node src/indoscraping/scraper/retail/indomaret/index.mjs",
        "scrape:blibli": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 node src/indoscraping/scraper/retail/blibli/index.mjs",
        "scrape:blibli-categories": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 node src/indoscraping/scraper/retail/blibli/categories.mjs",
        "scrape:blibli-holistic": "uv run src/indoscraping/scraper/retail/blibli/all_products.py",
        "scrape:blibli-priority": "uv run src/indoscraping/scraper/retail/blibli/all_products_filtered_by_c2_category.py",
        "scrape:banks": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 uv run python -m src.indoscraping.scraper.finance.index",
        "scrape:tokped": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 uv run python src/indoscraping/scraper/retail/tokopedia/scrape_tokped.py",
        "scrape:tokped-holistic": "uv run src/indoscraping/scraper/retail/tokopedia/holistic_scraper.py",
        "list:scrapers": "uv run python -c 'import os; print(\"Available scrapers:\"); [print(f\"- {f}\") for f in os.listdir(\"src/indoscraping/scraper/news\") if f.endswith(\".py\")]'"
    },
    "keywords": [
        "scraper",
        "indonesia",
        "python",
        "nodejs"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "playwright": "^1.43.1",
        "csv-writer": "^1.6.0"
    }
}