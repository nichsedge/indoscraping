{
    "name": "indoscraping",
    "version": "0.1.0",
    "description": "Indonesian web scrapers collection",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "indoscraping": "uv run indoscraping",
        "scrape:detik": "uv run python src/indoscraping/scraper/news/detik.py",
        "scrape:bisnis": "uv run python src/indoscraping/scraper/news/bisnis.py",
        "scrape:cnbc": "uv run python src/indoscraping/scraper/news/cnbcindonesia.py",
        "scrape:cnn": "uv run python src/indoscraping/scraper/news/cnnindonesia.py",
        "scrape:kompas": "uv run python src/indoscraping/scraper/news/kompas.py",
        "scrape:narasi": "uv run python src/indoscraping/scraper/news/narasi.py",
        "scrape:alfagift": "node src/indoscraping/scraper/retail/alfagift/index.mjs",
        "scrape:indomaret": "node src/indoscraping/scraper/retail/indomaret/index.mjs",
        "scrape:blibli-search": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 node src/indoscraping/scraper/retail/blibli/all_searched_products_pw.mjs",
        "scrape:blibli-holistic": "uv run python src/indoscraping/scraper/retail/blibli/all_products.py",
        "scrape:blibli-priority": "uv run python src/indoscraping/scraper/retail/blibli/all_products_filtered_by_c2_category.py",
        "scrape:banks": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 uv run python -m src.indoscraping.scraper.finance.index",
        "scrape:tokped": "uv run python src/indoscraping/scraper/retail/tokopedia/tokped_all_products.py",
        "list:scrapers": "uv run indoscraping list"
    },
    "keywords": [
        "scraper",
        "indonesia",
        "python",
        "nodejs"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "playwright": "^1.43.1",
        "csv-writer": "^1.6.0"
    }
}